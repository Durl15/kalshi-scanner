# Kalshi API Configuration
# ==========================
# Get your API credentials from: https://kalshi.com → Settings → API

# Your Kalshi API Key ID
KALSHI_API_KEY_ID=your-api-key-id-here

# Path to your private key PEM file
KALSHI_PRIVATE_KEY_PATH=./keys/private_key.pem

# Environment: "production" or "demo"
# Start with "demo" for testing!
KALSHI_ENVIRONMENT=demo

# Anthropic API Key (for AI-powered analysis)
ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional: Telegram Bot (for alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trading Settings
MAX_POSITION_SIZE_USD=100
MAX_DAILY_LOSS_USD=50
MIN_CONFIDENCE_THRESHOLD=0.65
